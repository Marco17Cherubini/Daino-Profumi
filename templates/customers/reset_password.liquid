{% comment %}
  Reset password — set a new password from the emailed link.
  (Shopify renders this template for the reset link; the "forgot password" request
  form lives on the login page.)
{% endcomment %}

{% section 'header' %}

<div class="customer-section">
  <div class="fade-in-up">
    <h1 class="customer-title">{{ 'customer.reset.title' | t }}</h1>
    <p class="customer-subtitle">{{ 'customer.reset.subtext' | t }}</p>

    {%- form 'reset_customer_password', class: 'customer-form' -%}
      {%- if form.errors -%}
        <div class="customer-errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="customer-field">
        <label class="customer-label" for="ResetPassword">{{ 'customer.login.password' | t }}</label>
        <input
          class="customer-input"
          type="password"
          id="ResetPassword"
          name="customer[password]"
          autocomplete="new-password"
          required
        >
      </div>

      <div class="customer-field">
        <label class="customer-label" for="ResetPasswordConfirm">{{ 'customer.activate.password_confirm' | t }}</label>
        <input
          class="customer-input"
          type="password"
          id="ResetPasswordConfirm"
          name="customer[password_confirmation]"
          autocomplete="new-password"
          required
        >
      </div>

      <button type="submit" class="customer-btn">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% section 'footer' %}
{% render 'customer-styles' %}
