{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      {{ 'gift_cards.issued.title' | t }}
      -
      {{ shop.name }}
    </title>
    {{ content_for_header }}
    <style>
      /* ============================================
       GIFT CARD DESIGN SYSTEM - DISPLAY
       Stile unificato con daino-giftcard-form.liquid
       ============================================ */

      /* Reset */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'SF Pro Text',
          sans-serif;
        background: #050507;
        color: #f7f5f0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      /* Container */
      .giftcard-section {
        width: 100%;
        max-width: 560px;
      }

      .giftcard-plaque {
        background: radial-gradient(circle at top, #181824, #040408);
        border: 1px solid rgba(212, 175, 55, 0.7);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
        border-radius: 22px;
        padding: 2.6rem 2.4rem;
        position: relative;
        overflow: hidden;
      }

      .giftcard-plaque::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        border: 1px solid rgba(255, 255, 255, 0.07);
        pointer-events: none;
      }

      /* Header */
      .giftcard-header {
        text-align: center;
        margin-bottom: 1.5rem;
      }

      .giftcard-shop-name {
        font-family: 'Cormorant Garamond', 'Times New Roman', serif;
        font-size: 1.6rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin: 0 0 0.25rem;
        color: #f7f5f0;
      }

      .giftcard-label {
        font-size: 0.85rem;
        color: rgba(247, 245, 240, 0.7);
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      /* Value */
      .giftcard-value {
        text-align: center;
        font-family: 'Cormorant Garamond', 'Times New Roman', serif;
        font-size: 3rem;
        background: linear-gradient(120deg, #d4af37, #f6e27a);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 1.5rem 0;
      }

      /* Image */
      .giftcard-image {
        width: 100%;
        max-width: 300px;
        margin: 0 auto 1.5rem;
        border: 2px solid rgba(212, 175, 55, 0.5);
        border-radius: 12px;
        overflow: hidden;
      }

      .giftcard-image img {
        width: 100%;
        height: auto;
        display: block;
      }

      /* Code */
      .giftcard-code-section {
        text-align: center;
        margin: 1.5rem 0;
      }

      .giftcard-code-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: rgba(247, 245, 240, 0.6);
        margin-bottom: 0.5rem;
      }

      .giftcard-code {
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', monospace;
        font-size: 1.4rem;
        letter-spacing: 0.15em;
        background: rgba(5, 5, 10, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 1rem 1.5rem;
        display: inline-block;
        color: #f7f5f0;
      }

      /* QR Code */
      .giftcard-qr {
        text-align: center;
        margin: 1.5rem 0;
      }

      .giftcard-qr img {
        width: 140px;
        height: 140px;
        border-radius: 8px;
        background: #fff;
        padding: 8px;
      }

      /* Balance & Expiry */
      .giftcard-info {
        text-align: center;
        font-size: 0.9rem;
        color: rgba(247, 245, 240, 0.7);
        margin: 1rem 0;
      }

      .giftcard-balance {
        color: #d4af37;
        font-weight: 600;
      }

      .giftcard-expiry {
        font-size: 0.8rem;
        color: rgba(247, 245, 240, 0.5);
      }

      /* Instructions */
      .giftcard-instructions {
        text-align: center;
        font-size: 0.85rem;
        color: rgba(247, 245, 240, 0.6);
        margin: 1.5rem 0;
        line-height: 1.6;
      }

      /* Buttons */
      .giftcard-actions {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1.5rem;
      }

      .giftcard-button {
        display: block;
        text-align: center;
        text-decoration: none;
        border: none;
        cursor: pointer;
        border-radius: 999px;
        padding: 0.9rem 1.6rem;
        font-size: 0.9rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 600;
        transition:
          transform 0.15s ease-out,
          box-shadow 0.15s ease-out,
          filter 0.15s ease-out;
      }

      .giftcard-button--primary {
        background: linear-gradient(120deg, #d4af37, #f6e27a);
        color: #1b1408;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
      }

      .giftcard-button--primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 40px rgba(0, 0, 0, 0.7);
        filter: brightness(1.05);
      }

      .giftcard-button--secondary {
        background: transparent;
        border: 1px solid rgba(212, 175, 55, 0.5);
        color: #d4af37;
      }

      .giftcard-button--secondary:hover {
        background: rgba(212, 175, 55, 0.1);
      }

      /* Print Button */
      .print-btn {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 10px 20px;
        background: rgba(212, 175, 55, 0.9);
        color: #1b1408;
        border: none;
        border-radius: 999px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: filter 0.2s ease;
      }

      .print-btn:hover {
        filter: brightness(1.1);
      }

      /* Print Styles */
      @media print {
        body {
          background: #fff;
          color: #000;
          padding: 1rem;
        }
        .giftcard-plaque {
          background: #fff;
          border-color: #d4af37;
          box-shadow: none;
        }
        .giftcard-shop-name,
        .giftcard-code {
          color: #000;
        }
        .giftcard-value {
          -webkit-text-fill-color: #d4af37;
        }
        .print-btn,
        .giftcard-button {
          display: none !important;
        }
      }

      /* Responsive */
      @media (max-width: 480px) {
        body {
          padding: 1rem;
        }
        .giftcard-plaque {
          padding: 1.9rem 1.5rem;
        }
        .giftcard-value {
          font-size: 2.2rem;
        }
        .giftcard-code {
          font-size: 1.1rem;
          padding: 0.75rem 1rem;
        }
      }
    </style>
  </head>
  <body>
    <section class="giftcard-section">
      <div class="giftcard-plaque">
        <!-- Header -->
        <header class="giftcard-header">
          <h1 class="giftcard-shop-name">{{ shop.name }}</h1>
          <p class="giftcard-label">{{ 'gift_cards.issued.title' | t }}</p>
        </header>

        <!-- Value -->
        <div class="giftcard-value">
          {{ gift_card.initial_value | money }}
        </div>

        <!-- Image -->
        {% if gift_card.image %}
          <div class="giftcard-image">
            {{ gift_card.image | image_url: width: 400 | image_tag: alt: '' }}
          </div>
        {% endif %}

        <!-- Code -->
        <div class="giftcard-code-section">
          <p class="giftcard-code-label">{{ 'gift_cards.issued.gift_card_code' | t }}</p>
          <div class="giftcard-code" id="giftcard-code">
            {{ gift_card.code }}
          </div>
        </div>

        <!-- QR Code -->
        <div class="giftcard-qr">
          <img
            src="{{ gift_card.qr_code_url }}"
            alt="{{ 'gift_cards.issued.qr_image_alt' | t }}"
            width="180"
            height="180"
          >
        </div>

        <!-- Balance (if different from initial) -->
        {% if gift_card.balance != gift_card.initial_value %}
          <p class="giftcard-info">
            {%- capture balance -%}<span class="giftcard-balance">{{ gift_card.balance | money }}</span>{%- endcapture -%}
            {{ 'gift_cards.issued.remaining_html' | t: balance: balance }}
          </p>
        {% endif %}

        <!-- Expiry -->
        {% if gift_card.expires_on %}
          <p class="giftcard-expiry">
            {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
            {{ 'gift_cards.issued.expires_on' | t: expires_on: expires_on }}
          </p>
        {% endif %}

        <!-- Instructions -->
        <p class="giftcard-instructions">
          {{ 'gift_cards.issued.instructions' | t }}
        </p>

        <!-- Actions -->
        <div class="giftcard-actions">
          <a href="{{ shop.url }}" class="giftcard-button giftcard-button--primary">
            {{ 'gift_cards.issued.shop_link' | t }}
          </a>
        </div>
      </div>
    </section>

    <!-- Print Button -->
    <button type="button" class="print-btn" data-print>{{ 'gift_cards.issued.print' | t }}</button>
    <script>
      document.querySelector('[data-print]').addEventListener('click', () => window.print());
    </script>
  </body>
</html>
