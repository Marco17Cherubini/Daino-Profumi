{% layout none %}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <style>
    :root {
      --color-gold: #D4AF37;
      --color-black: #000;
      --color-white: #fff;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
      background: var(--color-black);
      color: var(--color-white);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    .password-page {
      max-width: 400px;
      text-align: center;
    }
    .password-logo {
      width: 120px;
      margin: 0 auto 2rem;
    }
    .password-title {
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-size: 2rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 0.5rem;
    }
    .password-subtitle {
      color: rgba(255,255,255,0.7);
      margin-bottom: 2rem;
    }
    .password-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .password-input {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 999px;
      padding: 0.9rem 1.5rem;
      color: var(--color-white);
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s ease;
    }
    .password-input:focus {
      border-color: var(--color-gold);
    }
    .password-input::placeholder {
      color: rgba(255,255,255,0.5);
    }
    .password-button {
      background: linear-gradient(120deg, #d4af37, #f6e27a);
      color: #1b1408;
      border: none;
      border-radius: 999px;
      padding: 0.9rem 1.5rem;
      font-size: 1rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      cursor: pointer;
      transition: filter 0.2s ease;
    }
    .password-button:hover {
      filter: brightness(1.1);
    }
    .password-error {
      color: #ff6b6b;
      font-size: 0.9rem;
      margin-top: 1rem;
    }
    .password-footer {
      margin-top: 2rem;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.5);
    }
    .password-footer a {
      color: var(--color-gold);
      text-decoration: none;
    }
  </style>
</head>
<body>
  <main class="password-page">
    {% if shop.password_message != blank %}
      <div class="password-logo">
        {% if settings.main_logo %}
          <img src="{{ settings.main_logo | image_url: width: 200 }}" alt="{{ shop.name }}">
        {% else %}
          <h1 class="password-title">{{ shop.name }}</h1>
        {% endif %}
      </div>
      <p class="password-subtitle">{{ shop.password_message }}</p>
    {% else %}
      <h1 class="password-title">{{ shop.name }}</h1>
      <p class="password-subtitle">{{ 'general.password_page.login_form_heading' | t }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'password-form' %}
      <input 
        type="password" 
        name="password" 
        class="password-input" 
        placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
        required
      >
      <button type="submit" class="password-button">
        {{ 'general.password_page.login_form_submit' | t }}
      </button>
      {% if form.errors %}
        <p class="password-error">{{ 'general.password_page.login_form_error' | t }}</p>
      {% endif %}
    {% endform %}

    <div class="password-footer">
      {{ 'general.password_page.admin_link_html' | t }}
    </div>
  </main>
</body>
</html>
