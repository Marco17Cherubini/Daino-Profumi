{% comment %}
  Customer Addresses Page
{% endcomment %}

<div class="customer-section">
  <div class="customer-addresses-wrapper fade-in-up">
    <h1>{{ 'customer.account.addresses' | t }}</h1>
    
    <button type="button" class="action-btn" onclick="document.getElementById('new-address-form').classList.toggle('hidden')">
      Aggiungi nuovo indirizzo
    </button>
    
    <div id="new-address-form" class="hidden address-form-wrapper">
      {% form 'customer_address', customer.new_address %}
        <h3>Nuovo indirizzo</h3>
        {% render 'address-form', form: form %}
        <div class="form-actions">
          <button type="submit" class="giftcard-plaque-button">Salva</button>
        </div>
      {% endform %}
    </div>
    
    <div class="addresses-list">
      {% for address in customer.addresses %}
        <div class="address-card">
          <p>{{ address | format_address }}</p>
          {% if address == customer.default_address %}
            <span class="default-badge">Predefinito</span>
          {% endif %}
          <div class="address-actions">
            <button type="button" onclick="document.getElementById('edit-address-{{ address.id }}').classList.toggle('hidden')">
              Modifica
            </button>
            {% form 'customer_address', address %}
              <input type="hidden" name="_method" value="delete">
              <button type="submit">Elimina</button>
            {% endform %}
          </div>
          
          <div id="edit-address-{{ address.id }}" class="hidden address-form-wrapper">
            {% form 'customer_address', address %}
              {% render 'address-form', form: form, address: address %}
              <div class="form-actions">
                <button type="submit" class="giftcard-plaque-button">Aggiorna</button>
              </div>
            {% endform %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% render 'customer-styles' %}
