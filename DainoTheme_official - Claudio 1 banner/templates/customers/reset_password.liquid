{% comment %}
  Reset Password Page
{% endcomment %}

<div class="customer-section">
  <div class="customer-form-wrapper fade-in-up">
    <h1>Recupera password</h1>
    
    {% form 'recover_customer_password' %}
      {% if form.posted_successfully? %}
        <p class="form-success">Ti abbiamo inviato un'email con le istruzioni per reimpostare la password.</p>
      {% else %}
        <p class="form-intro">Inserisci il tuo indirizzo email e ti invieremo un link per reimpostare la password.</p>
        
        {% if form.errors %}
          <div class="form-errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        
        <div class="form-field">
          <label for="recover-email">Email</label>
          <input type="email" id="recover-email" name="email" autocomplete="email" required>
        </div>
        
        <div class="form-actions">
          <button type="submit" class="giftcard-plaque-button">Invia</button>
        </div>
        
        <div class="form-links">
          <a href="{{ routes.account_login_url }}">Torna al login</a>
        </div>
      {% endif %}
    {% endform %}
  </div>
</div>

{% render 'customer-styles' %}
