{% comment %}
  Activate Account Page
{% endcomment %}

<div class="customer-section">
  <div class="customer-form-wrapper fade-in-up">
    <h1>Attiva il tuo account</h1>
    <p class="form-intro">Crea la tua password per attivare l'account.</p>
    
    {% form 'activate_customer_password' %}
      {% if form.errors %}
        <div class="form-errors">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      
      <div class="form-field">
        <label for="password">Password</label>
        <input type="password" id="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      
      <div class="form-field">
        <label for="password-confirm">Conferma password</label>
        <input type="password" id="password-confirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      
      <div class="form-actions">
        <button type="submit" class="giftcard-plaque-button">Attiva account</button>
      </div>
    {% endform %}
  </div>
</div>

{% render 'customer-styles' %}
