{% comment %}
  Customer Login Page - Daino Theme
  Design luxury allineato alla landing page
{% endcomment %}

{% comment %} Include Header {% endcomment %}
{% section 'header' %}

<div class="login-section">
  <!-- Background Glow Effects -->
  <div class="login-glow login-glow--top"></div>
  <div class="login-glow login-glow--bottom"></div>
  
  <div class="login-container">
    <!-- Header -->
    <div class="login-header fade-in-up" style="animation-delay: 0.1s;">
      <h1 class="login-title">{{ 'customer.login.title' | t }}</h1>
      <p class="login-subtitle">Bentornato nel mondo dell'esclusività olfattiva.</p>
    </div>

    <!-- Login Form -->
    {% form 'customer_login', class: 'login-form fade-in-up', style: 'animation-delay: 0.2s;' %}
      {% if form.errors %}
        <div class="login-errors">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      
      <div class="login-field">
        <label for="customer-email" class="login-label">
          {{ 'customer.login.email' | t }}
        </label>
        <input 
          type="email" 
          id="customer-email" 
          name="customer[email]" 
          autocomplete="email" 
          required
          class="login-input"
          placeholder="nome@esempio.com"
        >
      </div>
      
      <div class="login-field">
        <div class="login-label-row">
          <label for="customer-password" class="login-label">
            {{ 'customer.login.password' | t }}
          </label>
          <a href="{{ routes.account_recover_url }}" class="login-forgot">
            {{ 'customer.login.forgot_password' | t }}
          </a>
        </div>
        <input 
          type="password" 
          id="customer-password" 
          name="customer[password]" 
          autocomplete="current-password" 
          required
          class="login-input"
          placeholder="••••••••"
        >
      </div>
      
      <div class="login-submit">
        <button type="submit" class="login-btn">
          {{ 'customer.login.submit' | t }}
        </button>
      </div>
    {% endform %}

    <!-- Register Link -->
    <div class="login-register fade-in-up" style="animation-delay: 0.4s;">
      <p class="login-register-text">Non hai ancora un account?</p>
      <a href="{{ routes.account_register_url }}" class="login-register-link">
        {{ 'customer.login.create_account' | t }}
      </a>
    </div>
  </div>
</div>

{% comment %} Include Footer {% endcomment %}
{% section 'footer' %}

<style>
  /* ============================================
     LOGIN PAGE - Aligned with Landing
     ============================================ */
  .login-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    padding-top: clamp(80px, 15vw, 120px); /* Space for header */
    padding-bottom: var(--space-2xl);
    position: relative;
    overflow: hidden;
    background-color: var(--daino-color-black);
  }

  /* Glow Effects - clamp() responsive */
  .login-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    background-color: var(--daino-color-gold);
    opacity: 0.05;
  }
  .login-glow--top {
    top: -20%;
    right: -10%;
    width: clamp(300px, 50vw, 600px);
    height: clamp(300px, 50vw, 600px);
    filter: blur(120px);
  }
  .login-glow--bottom {
    bottom: -20%;
    left: -10%;
    width: clamp(250px, 45vw, 500px);
    height: clamp(250px, 45vw, 500px);
    filter: blur(100px);
  }

  /* Container */
  .login-container {
    width: 100%;
    max-width: clamp(320px, 90vw, 420px);
    position: relative;
    z-index: 10;
  }

  /* Header */
  .login-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .login-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    text-transform: uppercase;
    letter-spacing: clamp(0.1em, 0.5vw, 0.15em);
    color: var(--daino-color-white);
    margin-bottom: var(--space-sm);
  }
  .login-subtitle {
    color: var(--daino-color-gray-light);
    font-weight: 300;
    letter-spacing: 0.05em;
    font-size: clamp(0.85rem, 2vw, 1rem);
  }

  /* Form */
  .login-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Fields */
  .login-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .login-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .login-label {
    font-family: var(--font-heading);
    font-size: clamp(0.65rem, 1.5vw, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--daino-color-gray-light);
  }
  .login-forgot {
    font-size: clamp(0.7rem, 1.5vw, 0.8rem);
    color: var(--daino-color-gold);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(212, 175, 55, 0.3);
    transition: color 0.3s ease;
  }
  .login-forgot:hover {
    color: var(--daino-color-white);
  }
  
  /* Input - aligned with landing colors */
  .login-input {
    width: 100%;
    background-color: var(--daino-color-gray-dark);
    border: 1px solid #333333;
    color: var(--daino-color-white);
    padding: clamp(12px, 2vw, 16px) var(--space-md);
    font-size: clamp(0.9rem, 2vw, 1rem);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .login-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }
  .login-input:focus {
    outline: none;
    border-color: var(--daino-color-gold);
    box-shadow: 0 0 0 1px var(--daino-color-gold);
  }

  /* Errors */
  .login-errors {
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
    padding: var(--space-sm);
    font-size: clamp(0.8rem, 1.8vw, 0.9rem);
    margin-bottom: var(--space-sm);
  }

  /* Submit Button - Gold primary like stitch */
  .login-submit {
    padding-top: var(--space-md);
  }
  .login-btn {
    width: 100%;
    background-color: var(--daino-color-gold);
    color: var(--daino-color-black);
    border: none;
    padding: clamp(14px, 2.5vw, 18px);
    font-family: var(--font-heading);
    font-size: clamp(0.65rem, 1.8vw, 0.85rem);
    text-transform: uppercase;
    letter-spacing: clamp(0.1em, 0.3vw, 0.2em);
    cursor: pointer;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 10px 20px rgba(212, 175, 55, 0.1);
  }
  .login-btn:hover {
    background-color: #b5952f;
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.2);
  }

  /* Register Link */
  .login-register {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }
  .login-register-text {
    color: var(--daino-color-gray-light);
    font-size: clamp(0.85rem, 2vw, 0.95rem);
    margin-bottom: var(--space-sm);
  }
  .login-register-link {
    font-family: var(--font-heading);
    color: var(--daino-color-white);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: clamp(0.8rem, 1.8vw, 0.9rem);
    border-bottom: 1px solid var(--daino-color-gold);
    padding-bottom: 2px;
    transition: color 0.3s ease;
    text-decoration: none;
  }
  .login-register-link:hover {
    color: var(--daino-color-gold);
  }

  /* Fade-in Animation */
  .fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
