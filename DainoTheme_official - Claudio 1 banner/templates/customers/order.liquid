{% comment %}
  Customer Order Page
{% endcomment %}

<div class="customer-section">
  <div class="customer-order-wrapper fade-in-up">
    <h1>Ordine {{ order.name }}</h1>
    <p class="order-date">Effettuato il {{ order.created_at | date: '%d %B %Y' }}</p>
    
    <div class="order-status">
      <span>Pagamento: {{ order.financial_status_label }}</span>
      <span>Spedizione: {{ order.fulfillment_status_label | default: 'In elaborazione' }}</span>
    </div>
    
    <table class="order-items-table">
      <thead>
        <tr>
          <th>Prodotto</th>
          <th>Quantità</th>
          <th>Prezzo</th>
        </tr>
      </thead>
      <tbody>
        {% for line_item in order.line_items %}
          <tr>
            <td>
              {{ line_item.title }}
              {% if line_item.variant.title != 'Default Title' %}
                <small>{{ line_item.variant.title }}</small>
              {% endif %}
            </td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    
    <div class="order-totals">
      <p><span>Subtotale:</span> <span>{{ order.subtotal_price | money }}</span></p>
      {% for shipping_method in order.shipping_methods %}
        <p><span>Spedizione ({{ shipping_method.title }}):</span> <span>{{ shipping_method.price | money }}</span></p>
      {% endfor %}
      <p class="order-total"><span>Totale:</span> <span>{{ order.total_price | money }}</span></p>
    </div>
    
    <div class="order-addresses">
      <div>
        <h3>Indirizzo di spedizione</h3>
        <p>{{ order.shipping_address | format_address }}</p>
      </div>
      <div>
        <h3>Indirizzo di fatturazione</h3>
        <p>{{ order.billing_address | format_address }}</p>
      </div>
    </div>
    
    <a href="{{ routes.account_url }}" class="action-btn">← Torna all'account</a>
  </div>
</div>

{% render 'customer-styles' %}
