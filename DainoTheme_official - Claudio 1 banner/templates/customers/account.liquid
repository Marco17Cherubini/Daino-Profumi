{% comment %}
  Customer Account Page
{% endcomment %}

<div class="customer-section">
  <div class="customer-account-wrapper fade-in-up">
    <header class="account-header">
      <h1>{{ 'customer.account.title' | t }}</h1>
      <p>Benvenuto, {{ customer.first_name }}</p>
      <a href="{{ routes.account_logout_url }}" class="action-btn">{{ 'customer.account.logout' | t }}</a>
    </header>
    
    <div class="account-grid">
      <div class="account-section">
        <h2>{{ 'customer.account.orders' | t }}</h2>
        {% if customer.orders.size > 0 %}
          <table class="orders-table">
            <thead>
              <tr>
                <th>Ordine</th>
                <th>Data</th>
                <th>Stato</th>
                <th>Totale</th>
              </tr>
            </thead>
            <tbody>
              {% for order in customer.orders %}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="no-orders">Non hai ancora effettuato ordini.</p>
        {% endif %}
      </div>
      
      <div class="account-section">
        <h2>{{ 'customer.account.addresses' | t }}</h2>
        <a href="{{ routes.account_addresses_url }}" class="action-btn">Gestisci indirizzi</a>
        
        {% if customer.default_address %}
          <div class="default-address">
            <p><strong>Indirizzo predefinito:</strong></p>
            <p>{{ customer.default_address | format_address }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% render 'customer-styles' %}
