{% comment %}
  Address Form Snippet
  Usage: {% render 'address-form', form: form %} or {% render 'address-form', form: form, address: address %}
{% endcomment %}

<div class="address-form">
  <div class="address-form__row address-form__row--half">
    <div class="customer-field">
      <label class="customer-label" for="{{ form.id }}_first_name">{{ 'customer.addresses.first_name' | t }}</label>
      <input
        type="text"
        id="{{ form.id }}_first_name"
        name="address[first_name]"
        value="{{ form.first_name }}"
        class="customer-input"
        autocomplete="given-name"
      >
    </div>
    <div class="customer-field">
      <label class="customer-label" for="{{ form.id }}_last_name">{{ 'customer.addresses.last_name' | t }}</label>
      <input
        type="text"
        id="{{ form.id }}_last_name"
        name="address[last_name]"
        value="{{ form.last_name }}"
        class="customer-input"
        autocomplete="family-name"
      >
    </div>
  </div>

  <div class="customer-field">
    <label class="customer-label" for="{{ form.id }}_company">{{ 'customer.addresses.company' | t }}</label>
    <input
      type="text"
      id="{{ form.id }}_company"
      name="address[company]"
      value="{{ form.company }}"
      class="customer-input"
      autocomplete="organization"
    >
  </div>

  <div class="customer-field">
    <label class="customer-label" for="{{ form.id }}_address1">{{ 'customer.addresses.address1' | t }}</label>
    <input
      type="text"
      id="{{ form.id }}_address1"
      name="address[address1]"
      value="{{ form.address1 }}"
      class="customer-input"
      autocomplete="address-line1"
    >
  </div>

  <div class="customer-field">
    <label class="customer-label" for="{{ form.id }}_address2">{{ 'customer.addresses.address2' | t }}</label>
    <input
      type="text"
      id="{{ form.id }}_address2"
      name="address[address2]"
      value="{{ form.address2 }}"
      class="customer-input"
      autocomplete="address-line2"
    >
  </div>

  <div class="address-form__row address-form__row--half">
    <div class="customer-field">
      <label class="customer-label" for="{{ form.id }}_city">{{ 'customer.addresses.city' | t }}</label>
      <input
        type="text"
        id="{{ form.id }}_city"
        name="address[city]"
        value="{{ form.city }}"
        class="customer-input"
        autocomplete="address-level2"
      >
    </div>
    <div class="customer-field">
      <label class="customer-label" for="{{ form.id }}_zip">{{ 'customer.addresses.zip' | t }}</label>
      <input
        type="text"
        id="{{ form.id }}_zip"
        name="address[zip]"
        value="{{ form.zip }}"
        class="customer-input"
        autocomplete="postal-code"
      >
    </div>
  </div>

  <div class="customer-field">
    <label class="customer-label" for="{{ form.id }}_country">{{ 'customer.addresses.country' | t }}</label>
    <select
      id="{{ form.id }}_country"
      name="address[country]"
      class="customer-input"
      data-default="{{ form.country }}"
      autocomplete="country"
    >
      {{ all_country_option_tags }}
    </select>
  </div>

  <div class="customer-field" id="{{ form.id }}_province_container" style="display: none;">
    <label class="customer-label" for="{{ form.id }}_province">{{ 'customer.addresses.province' | t }}</label>
    <select
      id="{{ form.id }}_province"
      name="address[province]"
      class="customer-input"
      data-default="{{ form.province }}"
      autocomplete="address-level1"
    >
    </select>
  </div>

  <div class="customer-field">
    <label class="customer-label" for="{{ form.id }}_phone">{{ 'customer.addresses.phone' | t }}</label>
    <input
      type="tel"
      id="{{ form.id }}_phone"
      name="address[phone]"
      value="{{ form.phone }}"
      class="customer-input"
      autocomplete="tel"
    >
  </div>

  {% if address %}
    <div class="address-form__default">
      <input
        type="checkbox"
        id="{{ form.id }}_default"
        name="address[default]"
        value="1"
        {% if address == customer.default_address %}checked{% endif %}
      >
      <label for="{{ form.id }}_default">{{ 'customer.addresses.set_default' | t }}</label>
    </div>
  {% endif %}
</div>

<style>
  .address-form__row--half {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .address-form__default {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .address-form__default input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--color-accent);
  }

  .address-form__default label {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .address-form__row--half {
      grid-template-columns: 1fr;
    }
  }
</style>
