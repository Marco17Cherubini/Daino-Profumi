{% schema %}
{
  "name": "Narrative Quote",
  "settings": [],
  "presets": [
    {
      "name": "Narrative Quote"
    }
  ]
}
{% endschema %}

<section class="consulenza-quote-section">
    <div class="quote-container scroll-reveal">
        <p class="reveal-text gold-pynion">Personalità e profumo viaggiano di pari passo,</p>
        <p class="reveal-text gold-pynion">questo è il nostro segreto per la consulenza olfattiva...</p>
        <br>
        <p class="reveal-text gold-pynion">Le personalità di Davide, Daniele e Robert</p>
        <p class="reveal-text gold-pynion">rispecchiano perfettamente i brand che preferiscono.</p>
        <br>
        <p class="reveal-text bodoni-sc">Volete qualcosa di estremamente personale</p>
        <p class="reveal-text bodoni-sc">e che possa davvero valorizzare ogni tratto della vostra persona?</p>
        <br>
        <p class="reveal-text bodoni-sc-gold">Raggiungeteci nelle nostre sedi</p>
    </div>
</section>

<style>
/* CONSULENZA QUOTE SECTION */
.consulenza-quote-section {
    padding: var(--space-3xl) var(--container-padding-desktop);
    background-color: #050507;
    text-align: center;
}

.quote-container {
    max-width: 900px;
    margin: 0 auto;
}

.quote-container .reveal-text {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.6;
    margin: var(--space-sm) 0;
    /* Impedisci spezzatura parole - vai a capo automaticamente */
    word-break: keep-all;
    overflow-wrap: normal;
    hyphens: none;
    -webkit-hyphens: none;
}

/* Gold Pynion style */
.quote-container .reveal-text.gold-pynion {
    font-family: 'Pinyon Script', var(--font-script), cursive;
    color: var(--daino-color-gold, #d4af37);
}

/* Bodoni Moda SC style - CAMBIATO IN CORMORANT GARAMOND */
.quote-container .reveal-text.bodoni-sc {
    font-family: 'Cormorant Garamond', var(--font-heading), serif;
    color: var(--daino-color-white);
}

/* Bodoni Moda SC Gold style - CAMBIATO IN CORMORANT GARAMOND */
.quote-container .reveal-text.bodoni-sc-gold {
    font-family: 'Cormorant Garamond', var(--font-heading), serif;
    color: var(--daino-color-gold, #d4af37);
}
</style>
