<footer class="footer-section scroll-reveal">
    <div class="footer-content">
        <!-- Three Column Layout: Address - Map - Contacts -->
        <div class="footer-three-cols">
            <!-- Left Column - Address -->
            <div class="footer-left">
                <h4>VIENI A TROVARCI</h4>
                <p>Via Vochieri 19, 15121, Alessandria</p>
                <p>Via Roma 63, 15067 Novi Ligure</p>
                <p>Italia</p>
                
                <!-- Newsletter -->
                <div class="footer-newsletter">
                    <h4>ISCRIVITI ALLA NOSTRA NEWSLETTER:</h4>
                    <form method="post" action="/contact#contact_form" id="newsletter-form" accept-charset="UTF-8" class="newsletter-form">
                        <input type="hidden" name="form_type" value="customer">
                        <input type="hidden" name="utf8" value="✓">
                        <input type="hidden" name="contact[tags]" value="newsletter">
                        <div class="newsletter-input-wrapper">
                            <input 
                                type="email" 
                                name="contact[email]" 
                                class="newsletter-input" 
                                placeholder="Inserisci la tua email" 
                                required
                                aria-label="Email per newsletter"
                            >
                            <button type="submit" class="newsletter-btn">Conferma</button>
                        </div>
                    </form>
                    <p class="newsletter-terms">
                        Inserendo la tua mail, accetti la nostra Informativa Clienti
                    </p>
                </div>
            </div>

            <!-- Center Column - Map Container -->
            <div class="footer-map-container">
                <a href="https://maps.app.goo.gl/vUJTH4UGxSvaMhVK6" target="_blank" rel="noopener" aria-label="Apri la mappa su Google Maps">
                    <img src="{{ 'footer-map.jpg' | asset_url }}" alt="Mappa della sede" class="footer-map-image">
                </a>
            </div>
            
            <!-- Right Column - Contacts & Social -->
            <div class="footer-right">
                <div class="footer-contacts">
                    <h4>CONTATTI</h4>
                    <a href="mailto:info@dainogioielli.it">info@dainogioielli.it</a>
                    <a href="tel:3275354547">3275354547</a>
                </div>
                <div class="footer-social">
                    {% if section.settings.instagram_url != blank %}
                        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>
                    {% endif %}
                    {% if section.settings.facebook_url != blank %}
                        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener">Facebook</a>
                    {% endif %}
                    {% if section.settings.tiktok_url != blank %}
                        <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener">TikTok</a>
                    {% endif %}
                </div>
                <div class="footer-legal">
                    <h4>INFORMATIVA CLIENTI</h4>
                    <a href="{{ policies.privacy_policy.url | default: '/policies/privacy-policy' }}">Informativa Sulla Privacy</a>
                    <a href="{{ policies.terms_of_service.url | default: '/policies/terms-of-service' }}">Termini & Condizioni</a>
                    <a href="{{ policies.shipping_policy.url | default: '/policies/shipping-policy' }}">Informazioni Spedizioni</a>
                    <a href="{{ policies.refund_policy.url | default: '/policies/refund-policy' }}">Rimborsi & Resi</a>
                </div>
            </div>
        </div>

        <!-- Bottom -->
        <div class="footer-bottom">
            <div>© 2026 DAINO PROFUMI</div>
            <div>P.IVA 02493280065</div>
        </div>
    </div>
</footer>

<style>
.footer-section {
    background-color: var(--daino-color-black);
    padding: var(--space-2xl) var(--container-padding);
}
.footer-content {
    max-width: 1200px;
    margin: 0 auto;
}

/* Footer Title */
.footer-title {
    font-family: var(--font-accent, 'Playfair Display', serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--daino-color-gold);
    text-align: center;
    margin-bottom: var(--space-2xl);
    letter-spacing: 0.02em;
}

/* Three Column Layout */
.footer-three-cols {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(0.5rem, 3vw, var(--space-xl));
    align-items: flex-start;
    margin-bottom: var(--space-xl);
}

/* Left Column - Address */
.footer-left {
    text-align: left;
}

/* Right Column - Contacts */
.footer-right {
    text-align: right;
}

.footer-left h4, .footer-right h4 {
    font-family: var(--font-heading);
    font-size: clamp(0.5rem, 1.5vw, 0.8rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--daino-color-gold);
    margin-bottom: clamp(0.2rem, 0.8vw, var(--space-md));
}

.footer-left p, .footer-contacts a, .footer-social a {
    font-size: clamp(0.45rem, 1.5vw, 0.9rem);
    color: var(--daino-color-gray-light);
    line-height: 1.4;
    display: block;
}

.footer-contacts a:hover, .footer-social a:hover {
    color: var(--daino-color-gold);
}

.footer-contacts {
    margin-bottom: clamp(0.5rem, 1.5vw, var(--space-lg));
}

/* Legal Links Section */
.footer-legal {
    margin-top: clamp(0.5rem, 1.5vw, var(--space-lg));
}

.footer-legal h4 {
    font-family: var(--font-heading);
    font-size: clamp(0.5rem, 1.5vw, 0.8rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--daino-color-gold);
    margin-bottom: clamp(0.2rem, 0.8vw, var(--space-md));
}

.footer-legal a {
    font-size: clamp(0.45rem, 1.5vw, 0.9rem);
    color: var(--daino-color-gray-light);
    line-height: 1.4;
    display: block;
    transition: color 0.3s ease;
}

.footer-legal a:hover {
    color: var(--daino-color-gold);
}

/* Map Container - Centered with responsive dimensions using clamp() */
.footer-map-container {
    width: clamp(100px, 20vw, 350px);
    height: clamp(80px, 16vw, 280px);
    border-radius: clamp(4px, 0.8vw, 8px);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    flex-shrink: 0;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
}

.footer-map-container:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
}

.footer-map-container img,
.footer-map-container iframe {
    width: 100%;
    height: 100%;
    border: none;
    object-fit: cover;
}

/* Newsletter Section */
.footer-newsletter {
    text-align: left;
    padding-top: clamp(0.4rem, 1.5vw, 1rem);
    margin-top: clamp(0.3rem, 1vw, 0.75rem);
}

.footer-newsletter h4 {
    font-size: clamp(0.5rem, 1.5vw, 0.8rem);
    letter-spacing: 0.1em;
}

.newsletter-form {
    max-width: clamp(100px, 25vw, 280px);
}

.newsletter-input-wrapper {
    display: flex;
    flex-direction: column;
    gap: clamp(0.25rem, 0.8vw, 0.5rem);
    align-items: flex-start;
}

.newsletter-input {
    width: 100%;
    padding: clamp(0.25rem, 0.8vw, 0.5rem) clamp(0.4rem, 1vw, 0.75rem);
    background-color: transparent;
    border: 1px solid var(--daino-color-gold, #d4af37);
    color: var(--daino-color-white);
    font-size: clamp(0.4rem, 1.2vw, 0.75rem);
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.newsletter-input::placeholder {
    color: var(--daino-color-gray-light);
    font-size: clamp(0.35rem, 1vw, 0.7rem);
}

.newsletter-input:focus {
    border-color: var(--daino-color-gold, #d4af37);
    box-shadow: 0 0 0 1px rgba(212, 175, 55, 0.2);
}

.newsletter-btn {
    padding: clamp(0.25rem, 0.8vw, 0.5rem) clamp(0.5rem, 1.5vw, 1rem);
    background-color: var(--daino-color-gold, #d4af37);
    color: var(--daino-color-black);
    border: 1px solid var(--daino-color-gold, #d4af37);
    font-size: clamp(0.35rem, 1vw, 0.7rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
}

.newsletter-btn:hover {
    background-color: transparent;
    color: var(--daino-color-gold, #d4af37);
}

.newsletter-terms {
    margin-top: clamp(0.25rem, 0.8vw, 0.5rem);
    font-size: clamp(0.35rem, 1vw, 0.65rem);
    color: var(--daino-color-gray-light);
}

.newsletter-terms-link {
    color: var(--daino-color-gray-light);
    text-decoration: underline;
    transition: color 0.3s ease;
}

.newsletter-terms-link:hover {
    color: var(--daino-color-gold, #d4af37);
}

/* Footer Bottom */
.footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: var(--space-lg);
    display: flex;
    justify-content: space-between;
    font-size: clamp(0.55rem, 1vw, 0.75rem);
    color: var(--daino-color-gray-light);
    letter-spacing: 0.1em;
}
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Mappa"
    },
    {
      "type": "html",
      "id": "map_embed",
      "label": "Google Maps Embed Code",
      "info": "Incolla il codice iframe da Google Maps"
    },
    {
      "type": "header",
      "content": "Indirizzo"
    },
    {
      "type": "text",
      "id": "address_line1",
      "label": "Negozio 1 - Via, civico, CAP, città, provincia",
      "default": "Via Vochieri 19, 15121, Alessandria"
    },
    {
      "type": "text",
      "id": "address_line2",
      "label": "Negozio 2 - Via, civico, CAP, città, provincia",
      "default": "Via Roma 63, 15067 Novi Ligure Alessandria"
    },
    {
      "type": "header",
      "content": "Contatti"
    },
    {
      "type": "text",
      "id": "contacts_title",
      "label": "Titolo sezione contatti",
      "default": "Contatti"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@dainogioielli.it"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefono",
      "default": "3275354547"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Link Instagram"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Link Facebook"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "Link TikTok"
    },
    {
      "type": "header",
      "content": "Legale"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Nome azienda",
      "default": "Daino Profumi"
    },
    {
      "type": "text",
      "id": "vat_number",
      "label": "P.IVA",
      "default": "P.IVA 02493280065"
    }
  ]
}
{% endschema %}
