{% comment %}
  MAIN COLLECTION - Griglia Prodotti Daino Theme
  Design luxury con filtri avanzati e layout responsive
  Utilizza Shopify Storefront Filtering API
{% endcomment %}

{{ 'collection-filters.css' | asset_url | stylesheet_tag }}

<div class="collection-section" data-collection-filters data-section-id="{{ section.id }}">
  
  <!-- Filters Overlay -->
  <div class="filters-overlay" data-filters-overlay></div>
  
  <!-- Filters Drawer -->
  <aside 
    class="filters-drawer filters-drawer--{{ section.settings.drawer_position }}" 
    data-filters-drawer
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'collections.filters.title' | t }}"
    aria-hidden="true"
  >
    <header class="filters-drawer__header">
      <h2 class="filters-drawer__title">{{ 'collections.filters.title' | t }}</h2>
      <button 
        class="filters-drawer__close" 
        data-filters-close
        aria-label="{{ 'collections.filters.close' | t }}"
      >
        &times;
      </button>
    </header>
    
    <div class="filters-drawer__body">
      <form data-filters-form>
        {% for filter in collection.filters %}
          {% assign is_brand_filter = false %}
          {% if filter.param_name contains 'brand' or filter.label == 'Brand' %}
            {% assign is_brand_filter = true %}
          {% endif %}
          <div class="filter-section is-open{% if is_brand_filter %} filter-section--brand{% endif %}" data-filter-section>
            <button 
              type="button"
              class="filter-header" 
              data-filter-header
              aria-expanded="true"
              aria-controls="filter-{{ filter.param_name | handleize }}"
            >
              <h3 class="filter-header__title">{{ filter.label }}</h3>
              <svg class="filter-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </button>
            
            <div class="filter-content" data-filter-content id="filter-{{ filter.param_name | handleize }}">
              <div class="filter-content__inner">
                {% case filter.type %}
                  {% when 'price_range' %}
                    <div class="price-range">
                      <input 
                        type="number" 
                        class="price-input" 
                        name="{{ filter.min_value.param_name }}"
                        data-price-min
                        placeholder="{{ filter.min_value.value | default: 0 | money_without_currency }}"
                        value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | remove: ',' }}{% endif %}"
                        min="0"
                        aria-label="{{ 'collections.filters.price_min' | t }}"
                      >
                      <span class="price-separator">–</span>
                      <input 
                        type="number" 
                        class="price-input" 
                        name="{{ filter.max_value.param_name }}"
                        data-price-max
                        placeholder="{{ filter.max_value.value | default: 1000 | money_without_currency }}"
                        value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | remove: ',' }}{% endif %}"
                        aria-label="{{ 'collections.filters.price_max' | t }}"
                      >
                    </div>
                    
                  {% when 'boolean' %}
                    {% for value in filter.values %}
                      <label class="filter-option">
                        <input 
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                        >
                        <span class="filter-option__label">{{ value.label }}</span>
                        {% if section.settings.show_counts %}
                          <span class="filter-option__count">({{ value.count }})</span>
                        {% endif %}
                      </label>
                    {% endfor %}
                    
                  {% when 'list' %}
                    {% comment %} 
                      Brand = selezione multipla (checkbox)
                      Formato = selezione singola (radio)
                    {% endcomment %}
                    {% assign input_type = 'checkbox' %}
                    {% if filter.param_name contains 'formato' or filter.param_name contains 'option' %}
                      {% assign input_type = 'radio' %}
                    {% endif %}
                    
                    {% comment %} Brand needs scroll wrapper {% endcomment %}
                    {% if is_brand_filter %}
                      <div class="filter-options-scroll">
                    {% endif %}
                    
                    {% for value in filter.values %}
                      <label class="filter-option">
                        <input 
                          type="{{ input_type }}"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                        >
                        <span class="filter-option__label">{{ value.label }}</span>
                        {% if section.settings.show_counts %}
                          <span class="filter-option__count">({{ value.count }})</span>
                        {% endif %}
                      </label>
                    {% endfor %}
                    
                    {% if is_brand_filter %}
                      </div>
                    {% endif %}
                {% endcase %}
              </div>
            </div>
          </div>
        {% endfor %}
      </form>
    </div>
    
    <footer class="filters-drawer__footer">
      <button type="button" class="filters-reset-btn" data-filters-reset>
        {{ 'collections.filters.reset' | t }}
      </button>
      <button type="button" class="filters-confirm-btn" data-filters-confirm>
        {{ 'collections.filters.apply' | t }}
      </button>
    </footer>
  </aside>
  
  <!-- Header -->
  <div class="collection-header scroll-reveal">
    <h1 class="collection-title">{{ collection.title }}</h1>
    <div class="collection-title-bar"></div>
    {% if collection.description != blank %}
      <p class="collection-description">{{ collection.description }}</p>
    {% endif %}
  </div>

  {% paginate collection.products by section.settings.products_per_page %}
  
    <!-- Toolbar: Filters Button + Sort + Count -->
    {% if section.settings.enable_filtering or section.settings.enable_sorting %}
      <div class="collection-toolbar scroll-reveal">
        <div class="collection-toolbar__left">
          {% if section.settings.enable_filtering %}
            <button class="filters-open-btn" data-filters-open aria-label="{{ 'collections.filters.open_filters' | t }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>
              </svg>
              {{ 'collections.filters.open_filters' | t }}
            </button>
          {% endif %}
          
          {% if section.settings.enable_sorting %}
            <div class="sort-select-wrapper">
              <select 
                class="sort-select" 
                data-sort-select
                aria-label="{{ 'collections.sorting.title' | t }}"
              >
                <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>
                  {{ 'collections.sorting.featured' | t }}
                </option>
                <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>
                  {{ 'collections.sorting.best_selling' | t }}
                </option>
                <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>
                  {{ 'collections.sorting.price_ascending' | t }}
                </option>
                <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>
                  {{ 'collections.sorting.price_descending' | t }}
                </option>
                <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>
                  {{ 'collections.sorting.title_ascending' | t }}
                </option>
                <option value="title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>
                  {{ 'collections.sorting.title_descending' | t }}
                </option>
                <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>
                  {{ 'collections.sorting.date_descending' | t }}
                </option>
                <option value="created-ascending" {% if collection.sort_by == 'created-ascending' %}selected{% endif %}>
                  {{ 'collections.sorting.date_ascending' | t }}
                </option>
              </select>
            </div>
          {% endif %}
        </div>
        
        <div class="collection-toolbar__right">
          {% assign result_from = paginate.current_offset | plus: 1 %}
          {% assign result_to = paginate.current_offset | plus: paginate.items %}
          {% if result_to > collection.products_count %}
            {% assign result_to = collection.products_count %}
          {% endif %}
          <span class="collection-count" data-product-count>
            {{ 'collections.filters.showing_results' | t: from: result_from, to: result_to, total: collection.products_count }}
          </span>
        </div>
      </div>
    {% endif %}
    
    <!-- Active Filters Tags -->
    {% if section.settings.show_active_filters %}
      <div class="active-filters" data-active-filters>
        {% assign has_active_filters = false %}
        {% for filter in collection.filters %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value != nil or filter.max_value.value != nil %}
              {% assign has_active_filters = true %}
            {% endif %}
          {% else %}
            {% for value in filter.values %}
              {% if value.active %}
                {% assign has_active_filters = true %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
        
        {% if has_active_filters %}
          <span class="active-filters__label">{{ 'collections.filters.active_filters' | t }}:</span>
          
          {% for filter in collection.filters %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                <span class="filter-tag">
                  {{ filter.min_value.value | default: 0 | money }} - {{ filter.max_value.value | default: 1000 | money }}
                  <button 
                    class="filter-tag__remove" 
                    data-remove-filter="{{ filter.min_value.param_name }}={{ filter.min_value.value }}"
                    aria-label="{{ 'collections.filters.remove' | t }}"
                  >&times;</button>
                </span>
              {% endif %}
            {% else %}
              {% for value in filter.values %}
                {% if value.active %}
                  <span class="filter-tag">
                    {{ filter.label }}: {{ value.label }}
                    <button 
                      class="filter-tag__remove" 
                      data-remove-filter="{{ value.param_name }}={{ value.value }}"
                      aria-label="{{ 'collections.filters.remove' | t }}"
                    >&times;</button>
                  </span>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}
          
          <button class="active-filters__clear" data-clear-all>
            {{ 'collections.filters.clear_all' | t }}
          </button>
        {% endif %}
      </div>
    {% endif %}

    <!-- Product Grid -->
    <div class="collection-grid-wrapper">
      <div class="collection-loading" data-loading-overlay>
        <div class="collection-loading__spinner"></div>
      </div>
      
      <div class="collection-grid" data-product-grid id="ProductGrid">
        {% for product in collection.products %}
          <article class="product-card scroll-reveal-card" data-delay="{{ forloop.index0 | modulo: 4 | times: 0.1 }}">
            <a href="{{ product.url }}" class="product-card__link">
              <!-- Image -->
              <!-- ✅ FIX 5A: Prime 9 immagini eager (above fold) -->
              <div class="product-card__image-wrapper">
                {% if product.featured_image %}
                  <img 
                    src="{{ product.featured_image | image_url: width: 600 }}" 
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    class="product-card__image"
                    {% if forloop.index <= 9 %}
                      loading="eager"
                      fetchpriority="high"
                    {% else %}
                      loading="lazy"
                    {% endif %}
                    width="600"
                    height="750"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
                {% endif %}

                <!-- Hover Overlay -->
                <div class="product-card__overlay">
                  <button class="product-card__view-btn">{{ 'collections.product_card.view' | t }}</button>
                </div>

                {% comment %} Badges {% endcomment %}
                {% if product.available == false %}
                  <span class="product-card__badge product-card__badge--soldout">{{ 'collections.product_card.sold_out' | t }}</span>
                {% endif %}
              </div>

              <!-- Info -->
              <div class="product-card__info">
                {% comment %} Mostra brand da metafield se disponibile, altrimenti vendor {% endcomment %}
                {% assign brand_name = product.metafields.custom.brand | default: product.vendor %}
                <span class="product-card__vendor">{{ brand_name }}</span>
                <h3 class="product-card__title">{{ product.title }}</h3>
                <span class="product-card__price">
                  {% if product.compare_at_price > product.price %}
                    <span class="product-card__price--compare">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                  {{ product.price | money }}
                </span>
              </div>
            </a>
          </article>
        {% else %}
          <div class="collection-empty">
            <p>{{ 'collections.filters.no_results' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn-gold">
              Torna allo shopping
            </a>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <nav class="collection-pagination fade-in-up" style="animation-delay: 0.5s;" aria-label="{{ 'general.pagination.label' | t }}">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="collection-pagination__btn" aria-label="{{ 'general.pagination.previous' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </a>
        {% endif %}

        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" class="collection-pagination__page">{{ part.title }}</a>
          {% else %}
            {% if part.title == paginate.current_page %}
              <span class="collection-pagination__page collection-pagination__page--current" aria-current="page">{{ part.title }}</span>
            {% else %}
              <span class="collection-pagination__ellipsis">...</span>
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="collection-pagination__btn" aria-label="{{ 'general.pagination.next' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </a>
        {% endif %}
      </nav>
    {% endif %}
  {% endpaginate %}
</div>

<script src="{{ 'collection-filters.js' | asset_url }}" defer></script>

<style>
  /* Fade-in Animation */
  .fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .collection-section {
    padding: var(--space-2xl) var(--container-padding);
    padding-top: clamp(100px, max(15vh, 15vw), 140px);
    max-width: 1400px;
    margin: 0 auto;
    min-height: 80vh;
    background-color: var(--daino-color-black);
  }

  /* Header */
  .collection-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .collection-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--daino-color-white);
    margin-bottom: var(--space-md);
  }
  .collection-title-bar {
    width: 80px;
    height: 2px;
    background-color: var(--daino-color-gold);
    margin: 0 auto var(--space-md);
  }
  .collection-description {
    max-width: 700px;
    margin: 0 auto;
    color: var(--daino-color-gray-light);
    font-style: italic;
    font-weight: 300;
    line-height: 1.6;
  }

  /* Grid */
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 3vw, 24px) clamp(8px, 2vw, 16px);
  }
  @media (max-width: 1200px) {
    .collection-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 768px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(8px, 2vw, 16px) clamp(6px, 1.5vw, 12px);
    }
  }

  /* Product Card */
  .product-card {
    position: relative;
  }
  .product-card__link {
    display: block;
    text-decoration: none;
  }
  .product-card__image-wrapper {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background-color: var(--daino-color-gray-dark);
    margin-bottom: var(--space-md);
  }
  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease, opacity 0.3s ease;
    opacity: 0.9;
  }
  .product-card:hover .product-card__image {
    transform: scale(1.05);
    opacity: 1;
  }
  .product-card__placeholder {
    width: 100%;
    height: 100%;
  }

  /* Overlay */
  .product-card__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .product-card:hover .product-card__overlay {
    opacity: 1;
  }
  .product-card__view-btn {
    background-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: var(--daino-color-white);
    padding: var(--space-xs) var(--space-md);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    transition: all 0.3s ease;
  }
  .product-card:hover .product-card__view-btn:hover {
    background-color: var(--daino-color-gold);
    border-color: var(--daino-color-gold);
  }

  /* Badges */
  .product-card__badge {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    padding: 4px 8px;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .product-card__badge--new {
    background-color: var(--daino-color-gold);
    color: var(--daino-color-black);
  }
  .product-card__badge--soldout {
    background-color: rgba(255, 255, 255, 0.9);
    color: var(--daino-color-black);
  }

  /* Info */
  .product-card__info {
    text-align: center;
    padding: clamp(4px, 1vw, 8px) clamp(2px, 0.5vw, 4px);
  }
  .product-card__vendor {
    font-size: clamp(0.55rem, 1.5vw, 0.7rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--daino-color-gray-light);
    margin-bottom: 2px;
    display: block;
  }
  .product-card__title {
    font-family: var(--font-heading);
    font-size: clamp(0.75rem, 2.5vw, 1rem);
    color: var(--daino-color-white);
    margin-bottom: 2px;
    transition: color 0.3s ease;
    line-height: 1.2;
  }
  .product-card:hover .product-card__title {
    color: var(--daino-color-gold);
  }
  .product-card__price {
    font-size: clamp(0.7rem, 2vw, 0.9rem);
    color: var(--daino-color-gray-light);
    font-weight: 500;
  }
  .product-card__price--compare {
    text-decoration: line-through;
    color: var(--daino-color-gray-light);
    margin-right: 4px;
  }

  /* Empty State */
  .collection-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-3xl) 0;
  }
  .collection-empty p {
    color: var(--daino-color-gray-light);
    margin-bottom: var(--space-lg);
  }
  
  /* Gold Button */
  .btn-gold {
    display: inline-block;
    background-color: var(--daino-color-gold, #d4af37);
    color: var(--daino-color-black);
    padding: var(--space-sm) var(--space-xl);
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    border: 2px solid var(--daino-color-gold, #d4af37);
    transition: all 0.3s ease;
  }
  .btn-gold:hover {
    background-color: transparent;
    color: var(--daino-color-gold, #d4af37);
  }

  /* Pagination */
  .collection-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-2xl);
  }
  .collection-pagination__btn,
  .collection-pagination__page {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--daino-color-gray-light);
    font-size: 0.9rem;
    transition: all 0.3s ease;
    border-radius: 50%;
  }
  .collection-pagination__btn:hover,
  .collection-pagination__page:hover {
    border-color: var(--daino-color-gold);
    color: var(--daino-color-gold);
  }
  .collection-pagination__page--current {
    background-color: var(--daino-color-gold);
    border-color: var(--daino-color-gold);
    color: var(--daino-color-black);
  }
  .collection-pagination__ellipsis {
    color: var(--daino-color-gray-light);
    margin: 0 var(--space-xs);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .collection-section {
      padding: var(--space-lg) var(--container-padding);
      padding-top: clamp(80px, 20vw, 120px);
    }
  }
</style>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "header",
      "content": "Filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "select",
      "id": "drawer_position",
      "label": "Filter drawer position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show product counts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_active_filters",
      "label": "Show active filter tags",
      "default": true
    },
    {
      "type": "header",
      "content": "Sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    }
  ]
}
{% endschema %}
