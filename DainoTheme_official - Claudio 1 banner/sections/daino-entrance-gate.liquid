{% schema %}
{
  "name": "Entrance Gate",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Scroll Indicator Text",
      "default": "Scorri per entrare"
    }
  ],
  "presets": [
    {
      "name": "Entrance Gate"
    }
  ]
}
{% endschema %}

<div class="hero-entrance-gate" id="entranceGate">
    {% if section.settings.logo %}
        {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'logo-entrance', id: 'logoEntrance', alt: shop.name }}
    {% else %}
        <!-- Fallback if user doesn't upload logo in section, uses theme settings or placeholder -->
        {% if settings.logo_main %}
             {{ settings.logo_main | image_url: width: 600 | image_tag: class: 'logo-entrance', id: 'logoEntrance', alt: shop.name }}
        {% else %}
             <img src="{{ 'logo_finito.png' | asset_url }}" alt="{{ shop.name }}" class="logo-entrance" id="logoEntrance">
        {% endif %}
    {% endif %}

    <div class="entrance-scroll-indicator" id="scrollIndicator">
        {{ section.settings.scroll_text | default: settings.enter_message }}
    </div>
</div>

<!-- Scroll spacer to enable scrolling during gate -->
<div class="gate-scroll-spacer" id="gateScrollSpacer"></div>
