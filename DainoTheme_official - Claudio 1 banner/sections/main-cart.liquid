{% comment %}
  MAIN CART - Pagina carrello Daino Theme
  Design luxury con layout a due colonne
{% endcomment %}

<div class="cart-section">
  <!-- Breadcrumb -->
  <nav class="cart-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="cart-breadcrumb__separator">/</span>
    <span class="cart-breadcrumb__current">{{ 'cart.general.title' | t }}</span>
  </nav>

  <h1 class="cart-title fade-in-up">{{ 'cart.general.title' | t }}</h1>
  
  {% if cart.item_count > 0 %}
    <div class="cart-layout">
      <!-- Items Column -->
      <div class="cart-items-column fade-in-up" style="animation-delay: 0.1s;">
        <!-- Table Header (Desktop) -->
        <div class="cart-header">
          <div class="cart-header__product">Prodotto</div>
          <div class="cart-header__price">Prezzo</div>
          <div class="cart-header__quantity">Quantità</div>
          <div class="cart-header__total">Totale</div>
        </div>

        <form action="{{ routes.cart_url }}" method="post" id="cart-form">
          {% for item in cart.items %}
            <div class="cart-item">
              <!-- Product Info -->
              <div class="cart-item__product">
                <div class="cart-item__image">
                  {% if item.image %}
                    <img 
                      src="{{ item.image | image_url: width: 200 }}" 
                      alt="{{ item.title | escape }}"
                      loading="lazy"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'cart-item__placeholder' }}
                  {% endif %}
                </div>
                <div class="cart-item__info">
                  <span class="cart-item__vendor">{{ item.vendor }}</span>
                  <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                  {% if item.variant.title != 'Default Title' %}
                    <p class="cart-item__variant">{{ item.variant.title }}</p>
                  {% endif %}
                  <button 
                    type="button" 
                    class="cart-item__remove-mobile"
                    onclick="window.location.href='/cart/change?line={{ forloop.index }}&quantity=0'"
                  >
                    Rimuovi
                  </button>
                </div>
              </div>

              <!-- Price -->
              <div class="cart-item__price">
                <span class="cart-item__label">Prezzo:</span>
                <span class="cart-item__value">{{ item.final_price | money }}</span>
              </div>

              <!-- Quantity -->
              <div class="cart-item__quantity">
                <span class="cart-item__label">Quantità:</span>
                <div class="cart-quantity">
                  <button 
                    type="button" 
                    class="cart-quantity__btn"
                    onclick="this.nextElementSibling.stepDown(); this.form.submit();"
                    aria-label="Diminuisci quantità"
                  >−</button>
                  <input 
                    type="number" 
                    name="updates[]" 
                    value="{{ item.quantity }}" 
                    min="0"
                    class="cart-quantity__input"
                    aria-label="Quantità"
                  >
                  <button 
                    type="button" 
                    class="cart-quantity__btn"
                    onclick="this.previousElementSibling.stepUp(); this.form.submit();"
                    aria-label="Aumenta quantità"
                  >+</button>
                </div>
              </div>

              <!-- Line Total -->
              <div class="cart-item__total">
                <span class="cart-item__label">Totale:</span>
                <span class="cart-item__value cart-item__value--total">{{ item.final_line_price | money }}</span>
                <button 
                  type="button" 
                  class="cart-item__remove-desktop"
                  onclick="window.location.href='/cart/change?line={{ forloop.index }}&quantity=0'"
                  aria-label="Rimuovi {{ item.title }}"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M18 6L6 18M6 6l12 12"/>
                  </svg>
                </button>
              </div>
            </div>
          {% endfor %}

          <!-- Order Notes -->
          <div class="cart-notes">
            <label for="cart-note" class="cart-notes__label">Note sull'ordine (Opzionale)</label>
            <textarea 
              id="cart-note" 
              name="note" 
              class="cart-notes__input"
              rows="3"
              placeholder="Istruzioni speciali per il tuo ordine..."
            >{{ cart.note }}</textarea>
          </div>

          <button type="submit" name="update" class="cart-update-btn">
            Aggiorna Carrello
          </button>
        </form>
      </div>

      <!-- Summary Column -->
      <div class="cart-summary-column fade-in-up" style="animation-delay: 0.2s;">
        <div class="cart-summary">
          <h2 class="cart-summary__title">Riepilogo Ordine</h2>
          
          <div class="cart-summary__rows">
            <div class="cart-summary__row">
              <span>Subtotale</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <div class="cart-summary__row">
              <span>Spedizione</span>
              <span class="cart-summary__shipping">Calcolata al checkout</span>
            </div>
            {% if cart.total_discount > 0 %}
              <div class="cart-summary__row cart-summary__row--discount">
                <span>Sconto</span>
                <span>-{{ cart.total_discount | money }}</span>
              </div>
            {% endif %}
          </div>

          <div class="cart-summary__total">
            <span>Totale</span>
            <span class="cart-summary__total-value">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-summary__tax-note">IVA inclusa</p>

          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="btn btn--primary cart-checkout-btn">
              Procedi al Checkout
            </button>
          </form>

          <div class="cart-summary__payment">
            <p>Accettiamo pagamenti sicuri con</p>
            <div class="cart-summary__payment-icons">
              {{ 'visa' | payment_type_svg_tag }}
              {{ 'mastercard' | payment_type_svg_tag }}
              {{ 'american_express' | payment_type_svg_tag }}
              {{ 'paypal' | payment_type_svg_tag }}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Continue Shopping -->
    <div class="cart-continue">
      <a href="{{ routes.all_products_collection_url }}" class="cart-continue__link">
        ← Continua lo shopping
      </a>
    </div>

  {% else %}
    <!-- Empty Cart -->
    <div class="cart-empty">
      <div class="cart-empty__icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
          <line x1="3" y1="6" x2="21" y2="6" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
      </div>
      <p class="cart-empty__text">{{ 'cart.general.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="cart-empty__btn cart-empty__btn--gold">
        {{ 'cart.general.continue_shopping' | t }}
      </a>
    </div>
  {% endif %}

  <!-- Related Products / Potrebbe Piacerti Anche -->
  {% if cart.item_count > 0 %}
    {% assign first_item = cart.items.first %}
    {% assign related_collection = first_item.product.collections.first %}
    {% if related_collection %}
      <section class="cart-related fade-in-up">
        <h2 class="cart-related__title">Potrebbe Piacerti Anche</h2>
        <div class="cart-related__grid">
          {% for product in related_collection.products limit: 4 %}
            {% assign cart_product_ids = cart.items | map: 'product_id' %}
            {% unless cart_product_ids contains product.id %}
              <a href="{{ product.url }}" class="cart-related-card">
                <div class="cart-related-card__image">
                  {% if product.featured_image %}
                    <img 
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.title | escape }}"
                      loading="lazy"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                  <div class="cart-related-card__overlay">
                    <span>Aggiungi</span>
                  </div>
                </div>
                <div class="cart-related-card__info">
                  <span class="cart-related-card__vendor">{{ product.vendor }}</span>
                  <h3 class="cart-related-card__name">{{ product.title }}</h3>
                  <span class="cart-related-card__price">{{ product.price | money }}</span>
                </div>
              </a>
            {% endunless %}
          {% endfor %}
        </div>
      </section>
    {% endif %}
  {% endif %}
</div>

<style>
  /* Fade-in Animation */
  .fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cart-section {
    padding: var(--space-xl) var(--container-padding);
    padding-top: clamp(100px, max(15vh, 15vw), 140px);
    max-width: 1200px;
    margin: 0 auto;
    min-height: 70vh;
  }

  /* Breadcrumb */
  .cart-breadcrumb {
    font-size: 0.85rem;
    margin-bottom: var(--space-lg);
    color: var(--daino-color-gray-light);
  }
  .cart-breadcrumb a {
    color: var(--daino-color-gray-light);
    transition: color 0.3s ease;
  }
  .cart-breadcrumb a:hover {
    color: var(--daino-color-gold);
  }
  .cart-breadcrumb__separator {
    margin: 0 var(--space-xs);
  }
  .cart-breadcrumb__current {
    color: var(--daino-color-white);
  }

  /* Title */
  .cart-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xl);
    color: var(--daino-color-white);
  }

  /* Layout */
  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-xl);
  }
  @media (max-width: 1024px) {
    .cart-layout {
      grid-template-columns: 1fr;
    }
  }

  /* Cart Header */
  .cart-header {
    display: none;
  }
  @media (min-width: 768px) {
    .cart-header {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: var(--space-md);
      padding-bottom: var(--space-md);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--daino-color-gray-light);
    }
    .cart-header__price,
    .cart-header__quantity,
    .cart-header__total {
      text-align: center;
    }
  }

  /* Cart Item */
  .cart-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  @media (min-width: 768px) {
    .cart-item {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      align-items: center;
    }
  }

  /* Product */
  .cart-item__product {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }
  .cart-item__image {
    width: 100px;
    height: 130px;
    flex-shrink: 0;
    background-color: var(--daino-color-gray-dark);
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }
  .cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .cart-item__image:hover img {
    transform: scale(1.05);
  }
  .cart-item__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cart-item__vendor {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--daino-color-gold);
  }
  .cart-item__title {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--daino-color-white);
    transition: color 0.3s ease;
  }
  .cart-item__title:hover {
    color: var(--daino-color-gold);
  }
  .cart-item__variant {
    font-size: 0.85rem;
    color: var(--daino-color-gray-light);
  }
  .cart-item__remove-mobile {
    font-size: 0.75rem;
    color: #ef4444;
    text-decoration: underline;
    background: none;
    border: none;
    cursor: pointer;
    margin-top: var(--space-xs);
    align-self: flex-start;
  }
  @media (min-width: 768px) {
    .cart-item__remove-mobile {
      display: none;
    }
  }

  /* Price, Quantity, Total */
  .cart-item__price,
  .cart-item__quantity,
  .cart-item__total {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  @media (min-width: 768px) {
    .cart-item__price,
    .cart-item__quantity,
    .cart-item__total {
      justify-content: center;
    }
    .cart-item__label {
      display: none;
    }
  }
  .cart-item__label {
    color: var(--daino-color-gray-light);
    font-size: 0.85rem;
  }
  .cart-item__value {
    color: var(--daino-color-white);
  }
  .cart-item__value--total {
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .cart-item__total {
    position: relative;
  }
  .cart-item__remove-desktop {
    display: none;
  }
  @media (min-width: 768px) {
    .cart-item__remove-desktop {
      display: block;
      position: absolute;
      right: -30px;
      opacity: 0;
      color: var(--daino-color-gray-light);
      background: none;
      border: none;
      cursor: pointer;
      transition: opacity 0.3s ease, color 0.3s ease;
    }
    .cart-item:hover .cart-item__remove-desktop {
      opacity: 1;
    }
    .cart-item__remove-desktop:hover {
      color: #ef4444;
    }
  }

  /* Quantity Controls */
  .cart-quantity {
    display: flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .cart-quantity__btn {
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    color: var(--daino-color-gray-light);
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .cart-quantity__btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--daino-color-white);
  }
  .cart-quantity__input {
    width: 40px;
    height: 36px;
    text-align: center;
    background: transparent;
    border: none;
    color: var(--daino-color-white);
    font-size: 0.9rem;
    -moz-appearance: textfield;
  }
  .cart-quantity__input::-webkit-outer-spin-button,
  .cart-quantity__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
  }

  /* Notes */
  .cart-notes {
    margin-top: var(--space-lg);
  }
  .cart-notes__label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--daino-color-gray-light);
    margin-bottom: var(--space-xs);
  }
  .cart-notes__input {
    width: 100%;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--daino-color-white);
    padding: var(--space-sm);
    font-size: 0.9rem;
    resize: vertical;
    transition: border-color 0.3s ease;
  }
  .cart-notes__input::placeholder {
    color: var(--daino-color-gray-light);
  }
  .cart-notes__input:focus {
    outline: none;
    border-color: var(--daino-color-gold);
  }

  /* Update Button */
  .cart-update-btn {
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-lg);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--daino-color-gray-light);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .cart-update-btn:hover {
    border-color: var(--daino-color-gold);
    color: var(--daino-color-gold);
  }

  /* Summary */
  .cart-summary {
    background-color: var(--daino-color-black);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: var(--space-lg);
    position: sticky;
    top: 100px;
  }
  .cart-summary__title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: var(--space-lg);
    color: var(--daino-color-white);
  }
  .cart-summary__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--daino-color-gray-light);
  }
  .cart-summary__row span:last-child {
    color: var(--daino-color-white);
  }
  .cart-summary__shipping {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--daino-color-gold) !important;
  }
  .cart-summary__row--discount span:last-child {
    color: #10b981 !important;
  }
  .cart-summary__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .cart-summary__total span:first-child {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--daino-color-white);
  }
  .cart-summary__total-value {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--daino-color-gold);
  }
  .cart-summary__tax-note {
    text-align: right;
    font-size: 0.7rem;
    color: var(--daino-color-gray-light);
    margin-top: 4px;
    margin-bottom: var(--space-lg);
  }
  .cart-checkout-btn {
    width: 100%;
    padding: var(--space-md);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
  }
  .cart-summary__payment {
    margin-top: var(--space-lg);
    text-align: center;
  }
  .cart-summary__payment p {
    font-size: 0.7rem;
    color: var(--daino-color-gray-light);
    margin-bottom: var(--space-sm);
  }
  .cart-summary__payment-icons {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    opacity: 0.5;
  }
  .cart-summary__payment-icons svg {
    height: 24px;
    width: auto;
  }

  /* Continue Shopping */
  .cart-continue {
    margin-top: var(--space-xl);
    text-align: center;
  }
  .cart-continue__link {
    font-size: 0.85rem;
    color: var(--daino-color-gray-light);
    transition: color 0.3s ease;
  }
  .cart-continue__link:hover {
    color: var(--daino-color-gold);
  }

  /* Empty Cart */
  .cart-empty {
    text-align: center;
    padding: 15vh 0;
  }
  .cart-empty__icon {
    color: var(--daino-color-gray-light);
    margin-bottom: var(--space-lg);
  }
  .cart-empty__text {
    color: var(--daino-color-gray-light);
    font-size: 1.1rem;
    margin-bottom: var(--space-xl);
  }
  .cart-empty__btn {
    display: inline-block;
    min-width: 220px;
    padding: var(--space-md) var(--space-xl);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s ease;
  }
  .cart-empty__btn.cart-empty__btn--gold {
    background-color: var(--daino-color-gold) !important;
    border: 1px solid var(--daino-color-gold) !important;
    color: var(--daino-color-black) !important;
  }
  .cart-empty__btn.cart-empty__btn--gold:hover {
    background-color: transparent !important;
    border-color: var(--daino-color-gold) !important;
    color: var(--daino-color-gold) !important;
  }

  /* Related Products */
  .cart-related {
    margin-top: var(--space-2xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .cart-related__title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xl);
    color: var(--daino-color-white);
  }
  .cart-related__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 3vw, 24px);
  }
  @media (max-width: 1024px) {
    .cart-related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* Mobile: mantieni SEMPRE 2 colonne */
  .cart-related-card {
    display: block;
    text-decoration: none;
  }
  .cart-related-card__image {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: var(--daino-color-gray-dark);
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: clamp(8px, 2vw, 16px);
  }
  .cart-related-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .cart-related-card:hover .cart-related-card__image img {
    transform: scale(1.1);
  }
  .cart-related-card__overlay {
    position: absolute;
    inset-x: 0;
    bottom: 0;
    padding: var(--space-md);
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(4px);
    transform: translateY(100%);
    transition: transform 0.3s ease;
    text-align: center;
  }
  .cart-related-card:hover .cart-related-card__overlay {
    transform: translateY(0);
  }
  .cart-related-card__overlay span {
    display: inline-block;
    border: 1px solid var(--daino-color-gold);
    color: var(--daino-color-gold);
    padding: var(--space-xs) var(--space-lg);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    transition: all 0.3s ease;
  }
  .cart-related-card:hover .cart-related-card__overlay span {
    background-color: var(--daino-color-gold);
    color: var(--daino-color-black);
  }
  .cart-related-card__info {
    text-align: center;
  }
  .cart-related-card__vendor {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--daino-color-gray-light);
    margin-bottom: 4px;
    display: block;
  }
  .cart-related-card__name {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--daino-color-white);
    margin-bottom: 4px;
