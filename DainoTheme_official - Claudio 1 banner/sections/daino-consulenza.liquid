{% schema %}
{
  "name": "Consulenza Olfattiva",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "L'angolo della consulenza olfattiva"
    }
  ],
  "blocks": [
    {
      "type": "staff",
      "name": "Staff Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Nome"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "brands",
          "label": "Favorite Brands"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Consulenza Olfattiva"
    }
  ]
}
{% endschema %}

<section class="consulenza-section">
    <h2 class="consulenza-title scroll-reveal">{{ section.settings.title }}</h2>

    {% for block in section.blocks %}
        <!-- Zig-Zag logic: Even blocks reverse -->
        <div class="staff-row {% cycle 'normal', 'reverse' %} scroll-reveal">
            <div class="staff-photo">
                {% if block.settings.photo %}
                    {{ block.settings.photo | image_url: width: 600 | image_tag: alt: block.settings.name }}
                {% else %}
                    {%- comment -%} Fallback images based on staff name {%- endcomment -%}
                    {% case block.settings.name %}
                        {% when 'Davide' %}
                            <img src="{{ 'davide_bw.jpeg' | asset_url }}" alt="Davide">
                        {% when 'Daniele' %}
                            <img src="{{ 'daniele_bw.jpeg' | asset_url }}" alt="Daniele">
                        {% when 'Robert' %}
                            <img src="{{ 'robert.jpeg' | asset_url }}" alt="Robert">
                        {% else %}
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endcase %}
                {% endif %}
            </div>
            <div class="staff-info">
                <h3 class="staff-name">{{ block.settings.name }}</h3>
                <p class="staff-description">{{ block.settings.description }}</p>
                <p class="staff-fragrances">{{ block.settings.brands }}</p>
                
                {% comment %} 
                  Staff brand selections - filter by metafield custom.brand
                  Format: filter.p.m.custom.brand=BrandName
                {% endcomment %}
                {% assign staff_url = '/collections/Catalogo' %}
                {% case block.settings.name %}
                    {% when 'Davide' %}
                        {% assign staff_url = staff_url | append: '?filter.p.m.custom.brand=Oman+Luxury&filter.p.m.custom.brand=Jeroboam&filter.p.m.custom.brand=Orto+Parisi' %}
                    {% when 'Daniele' %}
                        {% assign staff_url = staff_url | append: '?filter.p.m.custom.brand=Spirit+of+Kings&filter.p.m.custom.brand=Spirit+of+Dubai&filter.p.m.custom.brand=Kajal' %}
                    {% when 'Robert' %}
                        {% assign staff_url = staff_url | append: '?filter.p.m.custom.brand=Naso+Matto&filter.p.m.custom.brand=Bois+1920&filter.p.m.custom.brand=New+Notes' %}
                    {% else %}
                       {% assign staff_url = '/collections/Catalogo' %} 
                {% endcase %}
                
                <a href="{{ staff_url }}" class="staff-btn">Scopri la selezione</a>
            </div>
        </div>
    {% endfor %}
</section>
