{% schema %}
{
  "name": "Hero Video & Menu",
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Upload video to Files and paste URL here. Default: Video Project 2.mp4"
    },
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Title",
      "default": "L'Eccellenza della Profumeria d'Autore"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Subtitle",
      "default": "Oltre il profumo: l'espressione della tua anima."
    },
    {
      "type": "text",
      "id": "hero_cta_text",
      "label": "Button Text",
      "default": "Scopri le Fragranze"
    },
    {
      "type": "url",
      "id": "hero_cta_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand (Banner Superiore)",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name",
          "default": "Brand Name"
        }
      ]
    },
    {
      "type": "brand_bottom",
      "name": "Brand (Banner Inferiore)",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name",
          "default": "Brand Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Video & Menu",
      "blocks": [
        { "type": "brand", "settings": { "brand_name": "Spirit of Kings" } },
        { "type": "brand", "settings": { "brand_name": "Spirit of Dubai" } },
        { "type": "brand", "settings": { "brand_name": "Oman Luxury" } },
        { "type": "brand", "settings": { "brand_name": "Marrakech Imperial" } },
        { "type": "brand", "settings": { "brand_name": "Electimuss" } },
        { "type": "brand", "settings": { "brand_name": "Kajal" } },
        { "type": "brand", "settings": { "brand_name": "Bois 1920" } },
        { "type": "brand_bottom", "settings": { "brand_name": "Ghawali" } },
        { "type": "brand_bottom", "settings": { "brand_name": "Giardini di Toscana" } },
        { "type": "brand_bottom", "settings": { "brand_name": "Orto Parisi" } },
        { "type": "brand_bottom", "settings": { "brand_name": "Nasomatto" } },
        { "type": "brand_bottom", "settings": { "brand_name": "Jeroboam" } },
        { "type": "brand_bottom", "settings": { "brand_name": "Ojar" } },
        { "type": "brand_bottom", "settings": { "brand_name": "New Notes" } }
      ]
    }
  ]
}
{% endschema %}

<div class="hero-video-container" id="heroVideoContainer">
    <div class="cinematic-frame">
        <video muted loop playsinline class="hero-video" id="heroVideo">
            {% if section.settings.video_url != blank %}
                <source src="{{ section.settings.video_url }}" type="video/mp4">
            {% else %}
                <source src="{{ 'Video Project 2.mp4' | asset_url }}" type="video/mp4">
            {% endif %}
            Il tuo browser non supporta il tag video.
        </video>
    </div>

    <!-- ===== [HERO MENU (NAV)] ===== -->
    <nav class="hero-menu" id="heroMenu">
        <!-- Logo in Menu -->
        <a href="{{ routes.root_url }}">
             {% if settings.logo_main %}
                 {{ settings.logo_main | image_url: height: 60 | image_tag: class: 'menu-logo', alt: shop.name }}
             {% else %}
                 <img src="{{ 'logo_finito.png' | asset_url }}" alt="{{ shop.name }}" class="menu-logo">
             {% endif %}
        </a>

        <div class="menu-icons">
            <button type="button" class="menu-icon" title="Cerca" id="searchIcon" data-predictive-search-trigger>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="11" cy="11" r="8" />
                    <path d="M21 21l-4.35-4.35" />
                </svg>
            </button>
            <a href="/pages/collezioni?view=preferiti" class="menu-icon menu-icon--wishlist" title="Preferiti" id="wishlistIcon" data-wishlist-trigger>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
                <span class="wishlist-count" data-wishlist-count style="display: none;">0</span>
            </a>
            <a href="{{ routes.account_url }}" class="menu-icon" title="Account">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
            </a>
            <a href="{{ routes.cart_url }}" class="menu-icon" title="Carrello">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <path d="M16 10a4 4 0 0 1-8 0" />
                </svg>
            </a>
        </div>
    </nav>

    <!-- ===== [HERO CONTENT BANNER] ===== -->
    <div class="hero-content-banner" id="heroBanner">
        <h1 class="hero-title">{{ section.settings.hero_title }}</h1>
        <p class="hero-subtitle">{{ section.settings.hero_subtitle }}</p>
        <a href="{{ section.settings.hero_cta_link | default: routes.all_products_collection_url }}" class="hero-cta">{{ section.settings.hero_cta_text }}</a>
    </div>

    <!-- ===== [HERO BRANDS BANNER - SUPERIORE] ===== -->
    <div class="hero-brands-banner hero-brands-banner--top" id="heroBrandsBanner">
        <div class="brands-track">
            {% for block in section.blocks %}
                {% if block.type == 'brand' %}
                    {% assign brand_param = block.settings.brand_name | url_param_escape %}
                    <a href="{{ routes.all_products_collection_url }}?filter.p.m.custom.brand={{ brand_param }}" 
                       class="brand-item" 
                       style="text-decoration:none;"
                       data-brand="{{ block.settings.brand_name }}">
                      {{ block.settings.brand_name }}
                    </a>
                    <span class="brand-separator"></span>
                {% endif %}
            {% endfor %}
            <!-- Duplicati per loop infinito seamless -->
            {% for block in section.blocks %}
                {% if block.type == 'brand' %}
                    {% assign brand_param = block.settings.brand_name | url_param_escape %}
                    <a href="{{ routes.all_products_collection_url }}?filter.p.m.custom.brand={{ brand_param }}" 
                       class="brand-item" 
                       style="text-decoration:none;"
                       data-brand="{{ block.settings.brand_name }}"
                       aria-hidden="true">
                      {{ block.settings.brand_name }}
                    </a>
                    <span class="brand-separator"></span>
                {% endif %}
            {% endfor %}
        </div>
    </div>

    <!-- ===== [HERO BRANDS BANNER - INFERIORE] ===== -->
    <div class="hero-brands-banner hero-brands-banner--bottom" id="heroBrandsBannerBottom">
        <div class="brands-track brands-track--reverse">
            {% for block in section.blocks %}
                {% if block.type == 'brand_bottom' %}
                    {% assign brand_param = block.settings.brand_name | url_param_escape %}
                    <a href="{{ routes.all_products_collection_url }}?filter.p.m.custom.brand={{ brand_param }}" 
                       class="brand-item" 
                       style="text-decoration:none;"
                       data-brand="{{ block.settings.brand_name }}">
                      {{ block.settings.brand_name }}
                    </a>
                    <span class="brand-separator"></span>
                {% endif %}
            {% endfor %}
            <!-- Duplicati per loop infinito seamless -->
            {% for block in section.blocks %}
                {% if block.type == 'brand_bottom' %}
                    {% assign brand_param = block.settings.brand_name | url_param_escape %}
                    <a href="{{ routes.all_products_collection_url }}?filter.p.m.custom.brand={{ brand_param }}" 
                       class="brand-item" 
                       style="text-decoration:none;"
                       data-brand="{{ block.settings.brand_name }}"
                       aria-hidden="true">
                      {{ block.settings.brand_name }}
                    </a>
                    <span class="brand-separator"></span>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>

<!-- ===== [MOBILE MENU DRAWER] ===== -->
<div class="menu-overlay" id="menuOverlay"></div>
<div class="menu-drawer" id="menuDrawer">
    <span class="menu-drawer-close" id="menuClose">&times;</span>
    {%- for link in linklists.main-menu.links -%}
      <a href="{{ link.url }}" {% if link.active %}class="active"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}">Il Mio Account</a>
    {%- endif -%}
</div>

<!-- Predictive Search Dropdown -->
{% render 'predictive-search' %}
