{% comment %}
  DAINO GIFT CARD FORM
  Sezione per l'acquisto di gift card con design 3D plaque
  Usa come prodotto Gift Card nel tema
{% endcomment %}

<section class="giftcard-section">
  <div class="giftcard-wrapper">
    <div class="giftcard-plaque" id="giftcard-plaque">
      <div class="giftcard-plaque-inner">
        <header class="giftcard-header">
          <h2 class="giftcard-title">{{ section.settings.title | default: 'Crea il tuo Buono Regalo' }}</h2>
          <p class="giftcard-subtitle">
            {{ section.settings.subtitle | default: 'Un gesto su misura per chi ami. Compila i dettagli, il resto lo facciamo noi.' }}
          </p>
        </header>

        {% form 'product', product, id: 'giftcard-form', class: 'giftcard-form' %}
          <!-- Variante / Importo -->
          <div class="giftcard-field">
            <label for="giftcard-variant">Importo</label>
            <select id="giftcard-variant" name="id">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                  {{ variant.title }} — {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          </div>

          <!-- Destinatario -->
          <div class="giftcard-row">
            <div class="giftcard-field">
              <label for="recipient-first">Nome destinatario *</label>
              <input id="recipient-first" type="text" required name="properties[Nome destinatario]" autocomplete="off">
            </div>
            <div class="giftcard-field">
              <label for="recipient-last">Cognome destinatario *</label>
              <input id="recipient-last" type="text" required name="properties[Cognome destinatario]" autocomplete="off">
            </div>
          </div>

          <!-- Email Destinatario -->
          <div class="giftcard-field">
            <label for="recipient-email">Email destinatario *</label>
            <input id="recipient-email" type="email" required name="properties[Email destinatario]" autocomplete="off">
          </div>

          <!-- Mittente -->
          <div class="giftcard-field">
            <label for="sender-name">Il tuo nome (mittente) *</label>
            <input id="sender-name" type="text" required name="properties[Mittente]" autocomplete="off">
          </div>

          <!-- Messaggio -->
          <div class="giftcard-field">
            <label for="gift-message">Messaggio (opzionale)</label>
            <textarea id="gift-message" name="properties[Messaggio]" maxlength="200" rows="3"></textarea>
            <small class="giftcard-hint">Massimo 200 caratteri. Il messaggio sarà incluso nel buono regalo.</small>
          </div>

          <!-- Submit -->
          <div class="giftcard-actions">
            <button type="submit" class="giftcard-button" id="giftcard-submit">
              Aggiungi il buono al carrello
            </button>
            <div class="giftcard-status" id="giftcard-status" aria-live="polite"></div>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>

<style>
  /* ============================================
     GIFT CARD DESIGN SYSTEM - FORM
     ============================================ */
  .giftcard-section {
    padding: 4rem 1.5rem 6rem;
    display: flex;
    justify-content: center;
    background: #050507;
    overflow-x: hidden;
    max-width: 100vw;
    width: 100%;
  }

  .giftcard-wrapper {
    perspective: 1200px;
    max-width: 960px;
    width: 100%;
  }

  .giftcard-plaque {
    background: radial-gradient(circle at top, #181824, #040408);
    border: 1px solid rgba(212, 175, 55, 0.7);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
    border-radius: 22px;
    padding: 2.6rem 2.4rem;
    color: #f7f5f0;
    transform-style: preserve-3d;
    transform: rotateX(0deg) rotateY(0deg) translateZ(0);
    transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .giftcard-plaque::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.07);
    pointer-events: none;
  }

  .giftcard-plaque-inner {
    position: relative;
    z-index: 1;
  }

  /* Header */
  .giftcard-header {
    margin-bottom: 1.75rem;
    text-align: left;
  }

  .giftcard-title {
    font-family: "Cormorant Garamond", "Times New Roman", serif;
    font-size: 1.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    color: #f7f5f0;
  }

  .giftcard-subtitle {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
    font-size: 0.98rem;
    color: rgba(247, 245, 240, 0.8);
    margin: 0;
  }

  /* Form */
  .giftcard-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .giftcard-row {
    display: flex;
    gap: 1rem;
  }

  .giftcard-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .giftcard-field label {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(247, 245, 240, 0.8);
  }

  .giftcard-field input,
  .giftcard-field select,
  .giftcard-field textarea {
    background: rgba(5, 5, 10, 0.9);
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #f7f5f0;
    font-size: 0.9rem;
    padding: 0.7rem 1rem;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .giftcard-field textarea {
    border-radius: 16px;
    resize: vertical;
    min-height: 80px;
  }

  .giftcard-field input:focus,
  .giftcard-field select:focus,
  .giftcard-field textarea:focus {
    border-color: rgba(212, 175, 55, 0.9);
    box-shadow: 0 0 0 1px rgba(212, 175, 55, 0.5);
    background: rgba(8, 8, 14, 1);
  }

  .giftcard-hint {
    font-size: 0.75rem;
    color: rgba(247, 245, 240, 0.6);
  }

  /* Actions */
  .giftcard-actions {
    margin-top: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .giftcard-button {
    appearance: none;
    border: none;
    cursor: pointer;
    border-radius: 999px;
    padding: 0.9rem 1.6rem;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: linear-gradient(120deg, #d4af37, #f6e27a);
    color: #1b1408;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    transition: transform 0.15s ease-out, box-shadow 0.15s ease-out, filter 0.15s ease-out;
  }

  .giftcard-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.7);
    filter: brightness(1.05);
  }

  .giftcard-button:disabled {
    opacity: 0.6;
    cursor: default;
    transform: none;
    box-shadow: none;
  }

  .giftcard-status {
    font-size: 0.8rem;
    min-height: 1.2em;
    color: rgba(247, 245, 240, 0.8);
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .giftcard-section {
      padding: 3.5rem 1.25rem 4.5rem;
    }

    .giftcard-plaque {
      padding: 1.9rem 1.5rem;
    }

    .giftcard-title {
      font-size: 1.4rem;
    }

    .giftcard-row {
      flex-direction: column;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 3D Tilt Effect - Works on both desktop and mobile
    const plaque = document.getElementById('giftcard-plaque');
    
    if (plaque) {
      const maxRotate = 10;
      
      // Mouse events (desktop)
      plaque.addEventListener('mousemove', (e) => {
        const rect = plaque.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        
        const rotateY = -(x - 0.5) * 2 * maxRotate;
        const rotateX = (y - 0.5) * 2 * maxRotate;
        
        plaque.style.transform = `rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateZ(0)`;
        plaque.style.transition = 'transform 0.1s ease-out';
      });
      
      plaque.addEventListener('mouseleave', () => {
        plaque.style.transform = 'rotateX(0deg) rotateY(0deg) translateZ(0)';
        plaque.style.transition = 'transform 0.5s ease-out';
      });
      
      // Touch events (mobile)
      plaque.addEventListener('touchmove', (e) => {
        const touch = e.touches[0];
        const rect = plaque.getBoundingClientRect();
        const x = (touch.clientX - rect.left) / rect.width;
        const y = (touch.clientY - rect.top) / rect.height;
        
        const rotateY = -(x - 0.5) * 2 * maxRotate;
        const rotateX = (y - 0.5) * 2 * maxRotate;
        
        plaque.style.transform = `rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateZ(0)`;
        plaque.style.transition = 'transform 0.1s ease-out';
      }, { passive: true });
      
      plaque.addEventListener('touchend', () => {
        plaque.style.transform = 'rotateX(0deg) rotateY(0deg) translateZ(0)';
        plaque.style.transition = 'transform 0.5s ease-out';
      });
    }
  });
</script>

{% schema %}
{
  "name": "Gift Card Form",
  "tag": "section",
  "class": "daino-giftcard-form",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Crea il tuo Buono Regalo"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sottotitolo",
      "default": "Un gesto su misura per chi ami. Compila i dettagli, il resto lo facciamo noi."
    }
  ],
  "presets": [
    {
      "name": "Gift Card Form"
    }
  ]
}
{% endschema %}
