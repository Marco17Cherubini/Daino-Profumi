{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'section-legal-hub.css' | asset_url | stylesheet_tag }}
{% comment %}
  LEGAL HUB — page content followed by links to every policy configured in
  Settings › Policies. Used by templates/page.legal-hub.json.
{% endcomment %}

<div class="page-section legal-hub">
  <div class="page-content-wrapper">
    <h1 class="page-title">{{ page.title }}</h1>

    {% if page.content != blank %}
      <div class="page-content rte">
        {{ page.content }}
      </div>
    {% endif %}

    {% if shop.policies.size > 0 %}
      <nav class="legal-hub__nav" aria-labelledby="LegalHubHeading-{{ section.id }}">
        <h2 class="legal-hub__heading" id="LegalHubHeading-{{ section.id }}">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading | escape }}
          {%- else -%}
            {{ 'legal.policies_heading' | t }}
          {%- endif -%}
        </h2>
        <ul class="legal-hub__list" role="list">
          {% for policy in shop.policies %}
            <li>
              <a class="legal-hub__link" href="{{ policy.url }}">{{ policy.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Legal hub",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading above the policy links",
      "info": "Leave empty to use the translated default."
    }
  ]
}
{% endschema %}
