{
  "name": "daino-profumi-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Daino Profumi — custom Shopify Online Store 2.0 theme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "theme-check": "node scripts/theme-check.js .",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"assets/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:dom",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:dom": "node --test --test-concurrency=1 \"tests/dom/*.spec.js\"",
    "check": "npm run lint && npm run format:check && npm run theme-check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@shopify/prettier-plugin-liquid": "1.11.2",
    "@shopify/theme-check-node": "3.30.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
